{
  "name": "kctf-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "preview": "node scripts/dev.mjs --production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:migrate:dev": "prisma migrate dev",
    "db:deploy": "tsx scripts/db-deploy.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "outbox": "tsx --conditions=react-server scripts/outbox.ts",
    "retention": "tsx --conditions=react-server scripts/retention.ts",
    "payments": "tsx --conditions=react-server scripts/payments.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/geist": "^5.2.0",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@next/env": "16.4.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/functions": "^3.10.4",
    "gsap": "^3.15.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
