# KCTF website environment. Copy to .env.local for local work, or set these in the host.
# Never commit real values. Every variable here is read by the code; see README.md and
# docs/DEPLOYMENT.md for when each is required (B = build time, R = runtime).

# ── Site origin and indexing (B and R: keep identical for build and runtime) ──────────
# production | staging | preview | development | test. Defaults to development.
SITE_ENVIRONMENT=development
# Canonical origin, no path or trailing slash. In production: public https origin only.
SITE_URL=http://localhost:3000
# index | noindex. Only honoured when SITE_ENVIRONMENT=production. Defaults to noindex.
# Vercel deployments whose VERCEL_ENV is not "production" are always noindex.
SITE_INDEXING=noindex
# allow | disallow. disallow opts out of AI-training crawlers (GPTBot, Google-Extended,
# ClaudeBot, Applebot-Extended, CCBot) in robots.txt; search crawlers stay allowed.
# Owner decision; defaults to allow. See docs/SEO.md.
SITE_AI_TRAINING=allow

# ── Search-console verification (B; public tokens, not secrets; optional) ────────────
# Only the token from the meta tag's content attribute. Rendered only when indexable.
# Prefer DNS verification for Google Search Console and leave these empty.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Contact map (R; public, browser-visible key; optional) ────────────────────────────
# Google Maps Embed API key. Restrict it to the Maps Embed API and to the site's HTTP
# referrers. Never use a server or unrestricted key. Empty = no embedded map; the
# "Open in Google Maps" link still works. See docs/SEO.md.
GOOGLE_MAPS_EMBED_API_KEY=

# ── Neon PostgreSQL (R; CLI only for DIRECT_URL/SHADOW_DATABASE_URL) ──────────────────
# Application connection: Neon *pooled* string (host contains "-pooler").
DATABASE_URL=
# Migrations and `prisma migrate status`: Neon *direct* (non-pooled) string.
# `neon env pull` writes it as DATABASE_URL_UNPOOLED, which is used when DIRECT_URL is empty.
DIRECT_URL=
DATABASE_URL_UNPOOLED=
# Optional, local development only: a separate disposable database for `migrate dev`.
# Never a production or application database.
SHADOW_DATABASE_URL=

# ── Online enquiries (R) ──────────────────────────────────────────────────────────────
# true | false. false = email-draft mode. true with incomplete settings = form unavailable.
ENQUIRIES_ENABLED=false
# Resend API key (re_…) with sending access for the verified domain.
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. KCTF Website <enquiries@your-domain>
ENQUIRY_FROM=
# Staff inbox(es) for notifications: 1–5 addresses, comma-separated.
ENQUIRY_TO=
# Cloudflare Turnstile widget for the site hostname. Read by the server per request.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Abuse controls (R) ────────────────────────────────────────────────────────────────
# At least 32 random characters; keys the one-way digests used for rate limits.
ABUSE_HASH_SECRET=
# vercel = trust Vercel's client-IP headers; none = ignore forwarded headers (default).
TRUSTED_PROXY=none

# ── Outbox worker (R) ─────────────────────────────────────────────────────────────────
# At least 32 random characters. Enables /api/outbox/run (Vercel Cron sends it as Bearer).
CRON_SECRET=

# ── Retention (R and CLI). No default: set only once the foundation approves a policy ─
# Whole days after which stored enquiries are deleted by `npm run retention -- --execute`.
ENQUIRY_RETENTION_DAYS=
# true once the policy is approved. Online collection stays off until both are set.
RETENTION_POLICY_APPROVED=false

# ── Local test doubles (development/test only; refused elsewhere; loopback URLs) ──────
TURNSTILE_VERIFY_URL=
RESEND_API_URL=

# ── Integration tests only (optional) ─────────────────────────────────────────────────
# A disposable database whose name contains "test". Default: embedded PostgreSQL.
TEST_DATABASE_URL=
